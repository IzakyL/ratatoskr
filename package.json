{
  "name": "ratatoskr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "keygen": "node scripts/keygen.mjs",
    "migrate:local": "wrangler d1 migrations apply ratatoskr --local",
    "migrate:remote": "wrangler d1 migrations apply ratatoskr --remote",
    "typecheck": "tsc --noEmit",
    "invite": "node scripts/invite.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "reset-password": "node scripts/reset-password.mjs"
  },
  "dependencies": {
    "hono": "^4.12.29"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.110.0"
  },
  "allowScripts": {
    "workerd@1.20260708.1": true
  }
}
